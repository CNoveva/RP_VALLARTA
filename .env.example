# Variables de entorno de Tapanko Vallarta.
# En Coolify se capturan en la aplicación > Environment Variables (no se sube este archivo).

# Base de datos (servicio MySQL/MariaDB creado en Coolify)
DB_HOST=nombre-interno-del-servicio-mysql
DB_PORT=3306
DB_NAME=rpvallarta
DB_USER=rpvallarta
DB_PASS=cambiar-esta-contraseña

# Zona horaria de la sesión MySQL (-06:00 = Vallarta)
DB_TIMEZONE=-06:00

# Zona horaria del contenedor (PHP)
TZ=America/Mexico_City
